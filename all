const int MIN_INF=-2147483648; //-(2^31-1)

struct SegTree{
    // ノード番号は1-index、外は0-index
    // szを決めるとき入力nに対して[0,n)の範囲を確保するから、
    // インデックスNにアクセスしたいときは(2*N+1)を渡す
    int sz;
    vector<int> tree;

    SegTree(int n){
        sz=1;
        while(sz<n)sz*=2;
        tree.resize(2*sz,MIN_INF);
    }

    void update(int idx,int val){
        idx+=sz;
        tree[idx]=val;
        while(idx>1){
            idx/=2;
            tree[idx]=max(tree[idx*2],tree[idx*2+1]);
        }
    }

    // a,b: 要求区間 [a,b)
    // l,r: 現在のノードの担当区間 [l,r)
    // k: 現在のノード番号
    int query(int a,int b,int l,int r,int k){
        if(r<=a||b<=l)return MIN_INF;
        if(a<=l&&r<=b)return tree[k];
        int mid=(l+r)/2;
        int vl=query(a,b,l,mid,2*k);
        int vr=query(a,b,mid,r,2*k+1);
        return max(vl,vr);
    }

    // a,b: 要求区間 [a,b)
    int query(int a,int b){
        return query(a,b,0,sz,1);
    }
};

int main(){
    int n,q;
    cin>>n>>q;
    SegTree st(n);

    for(int i=0;i<q;i++){
        int com,x,y;
        cin>>com>>x>>y;
        if(com)cout<<st.query(x,y+1)<<endl;
        else st.update(x,y);
    }
}

