#include <bits/stdc++.h>
using namespace std;
using ll=long long;

// Tに好きな型を入れる(int とか)(main関数内で変える)
template <typename T>
struct FenwickTree{
    // 
    int n;
    vector<T> tree;

    // 1-indexだから0入れないでね
    FenwickTree(int n):n(n),tree(n+1,0){}

    //　一点加算
    void add(int idx,T val){
        for(;idx<=n;idx+=idx&-idx){
            tree[idx]+=val;
        }
        return;
    }

    // 累積和取得
    T sum(int idx){
        // 範囲外ストッパー
        // ここのせいでREがWAとして処理されてるかもしれないから注意
        if(idx<=0)return 0;
        idx=min(idx,n);
        
        T res=0;
        for(;idx>0;idx-=idx&-idx){
            res+=tree[idx];
        }
        return res;
    }

    // 区間和取得(実質累積和)
    // [l,r](閉区間)の累積和
    // lに0は入らない前提でやってる(0-indexだから)
    T query(int l,int r){
        return sum(r)-sum(l-1);
    }

    // k番目に小さい値のインデックスを取得
    // BITの中に頻度（0以上の値）を入れている場合のみ使用可能
    // 追加は add(idx,1) 、削除は add(idx,-1)

    // O(log n)
    // 1-indexed
    int kth(T k){
        if(k<=0)return 0;
        int place=0;
        T current_sum=0;

        // n以下の最大の2冪を求める
        int d=1;
        while(d<=n)d*=2;
        d/=2;

        // resとcurrent_sumを作る
        for(int i=d;i>0;i/=2){
            if(place+i<=n&&current_sum+tree[place+i]<k){
                current_sum+=tree[place+i];
                place+=i;
            }
        }
        return place+1;
    }
};

int main(){
    int N;
    cin>>N;
    FenwickTree<ll> ft(N);
}

