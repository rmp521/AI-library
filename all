// クラスカル法を用いて、
// O(|E|log|V|) で最小全域木のコストを求める
// 経路復元つき

struct UnionFind{
    // parent[i]>=0 -> 親の頂点番号
    // parent[i]< 0 -> 根 (絶対値がサイズ)
    vector<int> parent;

    int group_count; // グループ数

    UnionFind(int n):parent(n,-1),group_count(n){}

    // 頂点xの根を求める + 経路圧縮
    int root(int x){
        if(parent[x]<0)return x;

        parent[x]=root(parent[x]);
        return parent[x];
    }

    // 頂点 x と y が同じグループに属するか判定
    bool same(int x,int y){
        return root(x)==root(y);
    }

    // 頂点 x と y のグループを併合する

    bool unite(int x,int y){
        int rx=root(x);
        int ry=root(y);

        if(rx==ry)return false;

        if(-parent[rx]<-parent[ry])swap(rx,ry);

        parent[rx]+=parent[ry];
        parent[ry]=rx;

        group_count--;

        return true;
    }

    // x が属するグループのサイズ
    int size(int x){
        return -parent[root(x)];
    }

    // 現在の総グループ数
    int count(){
        return group_count;
    }
};

struct Edge{
    int u,v;
    long long cost;
    // 重みが小さい順にソートするための比較演算子
    bool operator< (const Edge &other) const{
        return cost<other.cost;
    }
};

// 最小全域木のコストの総和を返す
// グラフが非連結なら -1 を返す
// O(|E|log|V|)

// mst_edges は空の配列
long long kruskal(int V,vector<Edge> &edge,vector<Edge> mst_edges){
    // コストが小さい順に辺をソート
    sort(edge.begin(),edge.end());

    UnionFind uf(V); // 閉路判定用
    long long total_cost=0;
    int edge_count=0;

    // コストが低い辺から閉路ができないか判定しながら追加
    for(const auto &e:edge){
        if(uf.unite(e.u,e.v)){
            total_cost+=e.cost;
            edge_count++;

            // 追加した辺を保存
            mst_edges.push_back(e);

            // 頂点数 V-1 の辺を選んだ時点で終わり
            if(edge_count==V-1)break;
        }
    }

    // グラフが非連結の場合
    if(V>0 && edge_count < V-1){
        return -1;
    }

    return total_cost;
}

int main(){
    int V,E;            // 頂点数、辺の数
    vector<Edge> graph; // グラフ

    for(int i=0;i<E;i++){
        int u,v;
        long long cost;
        cin>>u>>v>>cost;
        // 0-indexedにするなら、 u--, v--
        graph.push_back({u,v,cost});
    }

    vector<Edge> mst_edges; // / 経路保存用の空の配列
    // mst_edges[i]={頂点1, 頂点2, コスト}; の形式で保存される

    long long ans=kruskal(V,graph,mst_edges);

    if(ans==-1)cout<<"graph has no connection"<<endl;
    else cout<<ans<<endl;
}

