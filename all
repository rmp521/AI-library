using ll=long long;

struct SegTree{
    // ノード番号は1-index、外は0-index
    int sz;
    vector<ll> tree;

    SegTree(int n){
        sz=1;
        while(sz<n)sz*=2;
        tree.resize(2*sz,0);
    }

    // 元の値を"変更"するとき
    void update(int idx,int val){
        idx+=sz;
        tree[idx]=val;
        while(idx>1){
            idx/=2;
            tree[idx]=tree[idx*2]+tree[idx*2+1];
        }
    }

    // 元の値に"加算"する場合
    void add(int idx,int val){
        idx+=sz;
        tree[idx]+=val;
        while(idx>1){
            idx/=2;
            tree[idx]=tree[idx*2]+tree[idx*2+1];
        }
    }

    // a,b: 要求区間 [a,b)
    // l,r: 現在のノードの担当区間 [l,r)
