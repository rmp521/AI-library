vector<bool> sieve(int x){
    vector<bool> isPrime(x+1,true);
    isPrime[0]=false;
    isPrime[1]=false;
    for(int i=4;i<=x;i+=2){
        isPrime[i]=false;
    }
    for(int i=3;i*i<=x;i+=2){
        if(isPrime[i]){
            int save=i*i;
            while(save<=x){
                isPrime[save]=false;
                save+=i;
            }
        }
    }
    return isPrime;
}

