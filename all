#include <bits/stdc++.h>
using namespace std;

// O(V×E)
// Vは頂点の数
// Eは辺の数

// 到達不可能な値にする
const long long INF=1e18;

// 辺の構造体
struct Edge{
    int to;
    long long cost;
};

struct bellman_ford_result{
    bool negative_cycle;
    vector<long long> dist;
    vector<int> prev;
};

bellman_ford_result bellman_ford(vector<vector<Edge>> &G,int start){
    int V=G.size(); // 頂点数
    vector<long long> dist(V,INF);
    vector<int> prev(V,-1);

    dist[start]=0;

    for(int i=0;i<V-1;i++){ // (V-1)回操作する
        bool update=false;
        for(int v=0;v<V;v++){
            if(dist[v]==INF)continue;

            // 到達できる全ての頂点から出てる辺をチェック
            for(auto &edge:G[v]){
                if(dist[v]+edge.cost<dist[edge.to]){
                    dist[edge.to]=dist[v]+edge.cost;
                    prev[edge.to]=v;
                    update=true;
                }
            }
        }
        // 変更が無かったら終了
        if(!update)break;
    }

    // 負の閉路の検出
    bool negative_cycle=false;
    for(int v=0;v<V;v++){
        if(dist[v]==INF)continue;

        // 変更があるか確認
        // 変更がある->負の閉路が存在する((V-1)回の更新で最短経路は必ず確定する)
        for(auto &edge:G[v]){
            if(dist[v]+edge.cost<dist[edge.to]){
                negative_cycle=true;
            }
        }
    }

    return {negative_cycle,dist,prev};
}

int main(){
    int V;
    cin>>V;

    // graphをEdgeを使って宣言
    vector<vector<Edge>> graph(V);

    int s; // 始点
    cin>>s;
    
    // 返り値の受け取り方
    // 事前にdist,prevの宣言は不要
    auto [negative_cycle,dist,prev]=bellman_ford(graph,s);

    int t; // 終点
    cin>>t;

    // 経路復元
    vector<int> route;
    for(int cur=t;cur!=-1;cur=prev[cur]){
        route.push_back(cur);
    }
    reverse(route.begin(),route.end());
}

