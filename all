#include <bits/stdc++.h>
using namespace std;

// 0-indexedであることに注意1
// 0-indexedであることに注意2

// 番号付けはDFS内で行われるから、入力順はバラバラでもいい
// 入力ではつなぎ方さえ分かればいい

// 辺を表す構造体
struct Edge{
    int to;
    long long cost;
};

struct EulerTour{
    int n; // 頂点数
    vector<vector<Edge>> g; // 隣接リスト

    // LCA(最小共通祖先)用
    vector<int> tour;      // DFSの頂点の軌跡
    vector<int> depth;     // 頂点の深さ
    vector<int> in;        // DFSで初めて見たときのtourのindex
    vector<int> out;       // DFSを抜けたときのtourのindex

    // 根からの重みつき距離
    vector<long long> dist_root;

    vector<vector<int>> sp_table; // Sparse Table用の配列

    // 配列のサイズをNに初期化
    EulerTour(int n):n(n),g(n),depth(n),in(n),out(n),dist_root(n){}

    void add_edge(int u,int v,long long cost){
        g[u].push_back({v,cost});
        g[v].push_back({u,cost});
    }

    // v: 現在の頂点  p: 親の頂点  d: 現在の深さ
    // O(N)
    void dfs(int v,int p,int d,long long w){
        depth[v]=d;        // 深さを記録
        in[v]=tour.size(); // 初めて訪れたときのtourのindexを記録
        tour.push_back(v); // 軌跡を追加
        dist_root[v]=w;    // 重みつき距離を記録
        
        for(auto e:g[v]){
            if(e.to==p)continue; // 親に戻ることを防止
            dfs(e.to,v,d+1,w+e.cost);
            tour.push_back(v);
        }

        out[v]=tour.size();
    }

    // Sparse Tableを構築する関数
    // O(NlogN)
    void build_rmq(){
        int sz=tour.size();

        int max_log=32-__builtin_clz(sz); // GCC拡張の機能 31-(最上位セットビット)+1をしてる
        // int max_log=32-bit_width((unsigned int)sz); C++20の機能　31-(最上位セットビット)+1をしてる

        sp_table.assign(max_log,vector<int> (sz));

        // Sparse Tableの構築
        for(int i=0;i<sz;i++){
            sp_table[0][i]=tour[i];
        }

        for(int k=1;k<max_log;k++){
            for(int i=0;i+(1<<k)<=sz;i++){
                int u=sp_table[k-1][i];
                int v=sp_table[k-1][i+(1<<(k-1))];
                
                if(depth[u]<depth[v])sp_table[k][i]=u;
                else sp_table[k][i]=v;
            }
        }
    }

    // tour,depth,sp_tableの構築用
    // 根が0じゃなかったら引数に入れる
    // 根が0なら引数なしでOK
    // O(NlogN)
    void build(int root=0){
            dfs(root,-1,0,0LL);
        build_rmq();
    }

    // 頂点u と頂点v のLCA(最小共通祖先)を求める
    // O(1)
    int lca(int u,int v){
        int l=in[u];
        int r=in[v];

        // l<=r となるようにする
        if(l>r)swap(l,r);

        // Sparse Tableにおける区間の長さ
        int len=r-l+1;

        // Sparse Tableのために、最大の 2^k < len を求める
        int k=31-__builtin_clz(len);
        // int k=31-bit_width((unsigned int)len);

        // Sparse Tableで区間の最小値を求める
        int node1=sp_table[k][l];
        int node2=sp_table[k][r-(1<<k)+1];

        if(depth[node1]<depth[node2])return node1;
        else return node2;
    }

    // 頂点u と頂点v の"重み付き"距離を求める
    // O(1)
    long long dist(int u,int v){
        return dist_root[u]+dist_root[v]-2LL*dist_root[lca(u,v)];
    }

    // 頂点u と頂点v の"重みなし"距離を求める
    // O(1)
    int unweighted_dist(int u,int v){
        return depth[u]+depth[v]-2*depth[lca(u,v)];
    }

    // 任意の頂点配列をDFSの訪問順にsort
    // O(NlogN)
    void DFSsort(vector<int> &vec){
        sort(vec.begin(),vec.end(),[&](int a,int b){
            return in[a]<in[b];
        });
    }

    // 訪問順でsortした配列上のlower_bound
    // 訪問時間が time 以上になる最初のindexを返す
    // 返り値がイテレータでないことに注意!
    // O(log|vec|)
    int lower_bound_tour(const vector<int> &vec,int time){
        auto it=lower_bound(vec.begin(),vec.end(),time,
            [&](int a,int val){return in[a]<val;}
        );
        return it-vec.begin();
    }

    // 訪問順でsortした配列上のupper_bound
    // 訪問時間が time より大きいになる最初のindexを返す
    // 返り値がイテレータでないことに注意!
    // O(log|vec|)
    int upper_bound_tour(const vector<int> &vec,int time){
        auto it=upper_bound(vec.begin(),vec.end(),time,
            [&](int val,int a){return val<in[a];} // lower_bound と引数の順番が違うけどこれでOKです(たぶん)
        );
        return it-vec.begin();
    }

    // 訪問時刻が[l_time,r_time) の範囲に含まれる頂点の個数を返す
    // sort済み配列に対して行う
    //O(log|vec|)
    int count_range(const vector<int> &vec,int l_time,int r_time){
        if(vec.empty())return 0;

        int l_idx=lower_bound_tour(vec,l_time);
        int r_idx=lower_bound_tour(vec,r_time);

        return r_idx-l_idx;
    }

    // 頂点u が頂点v の祖先であるか判定
    // O(1)
    bool is_ancestor(int u,int v){
        return in[u]<=in[v] && out[v]<=out[u];
    }

    //頂点x が頂点u と頂点v の最短パス上に存在するか判定
    // O(1)
    bool is_on_path(int u,int v,int x){
        return unweighted_dist(u,x)+unweighted_dist(x,v)==unweighted_dist(u,v);
    }
};


// ===============ここからmain関数===============
int main(){
    // 0-indexed に注意←←←←←←←←←←←←←←←←←←←←←←←←←←←←←←←

    int N; // N: 頂点数
    cin>>N;

    // 頂点の数を渡す
    EulerTour et(N);

    // 辺の追加
    // ループ範囲に注意
    for(int i=1;i<N;i++){
