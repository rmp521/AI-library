// 到達不可能な値にする
const long long INF=1e18;

// 辺の構造体
struct Edge{
    int to;
    long long cost;
};

// 戻り値用の構造体
struct dijkstra_result{
    vector<long long> dist;
    vector<int> prev;
};

dijkstra_result dijkstra(vector<vector<Edge>> &G,int start){
    int V=G.size(); // 頂点数

    // 記録用配列
    vector<long long> dist(V,INF);
    vector<int> prev(V,-1);

    using pli=pair<long long,int>; // { dist, v(頂点) }

    // ""startから"" 一番近い頂点をO(logN)で求められる
    // その頂点に隣接する頂点は全探索して、最短距離を更新
    // 全探索してもO(E)にしかならない。(Eは辺の数)
    priority_queue<pli,vector<pli>,greater<pli>> pq;

    dist[start]=0;
    pq.push({0,start});

    while(!pq.empty()){
        auto [cur_dist,v]=pq.top();
        pq.pop();
        
        if(cur_dist>dist[v])continue;

        // vに隣接する頂点edgeについて全探索
        for(auto &edge:G[v]){
            if(dist[v]+edge.cost<dist[edge.to]){
                dist[edge.to]=dist[v]+edge.cost;
                prev[edge.to]=v;
                pq.push({dist[edge.to],edge.to});
            }
        }
    }

    return {dist,prev};
}

int main(){
    int V;
    cin>>V;

    // graphをEdgeを使って宣言
    vector<vector<Edge>> graph(V);

    int s; // 始点
    cin>>s;
    
    // 返り値の受け取り方
    // 事前にdist,prevの宣言は不要
    auto [dist,prev]=dijkstra(graph,s);

    int t; // 終点
    cin>>t;

    // 経路復元
    vector<int> route;
    for(int cur=t;cur!=-1;cur=prev[cur]){
        route.push_back(cur);
    }
    reverse(route.begin(),route.end());
}

