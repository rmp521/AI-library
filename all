struct Factorizer{
    int n;
    vector<int> spf; // spf[i] : iを割り切る最小の素数
    vector<bool> Prime;

    Factorizer(int size):n(size),spf(size+1),Prime(size+1,true){
        for(int i=0;i<=n;i++)spf[i]=i;

        if(n>=0)Prime[0]=false;
        if(n>=1)Prime[1]=false;

        for(int i=4;i<=n;i+=2){
            Prime[i]=false;
            spf[i]=2;
        }

        for(int i=3;i<=n/i;i+=2){
            if(Prime[i]){
                for(int j=i*i;j<=n;j+=i*2){
                    Prime[j]=false;
                    if(spf[j]==j)spf[j]=i;
                }
            }
        }
    }

    // O(logN)
    vector<pair<int,int>> factorize(int x) const{
        vector<pair<int,int>> res;
        while(x>1){
            int p=spf[x];
            int exp=0;
            while(spf[x]==p){
                exp++;
                x/=p;
            }
            res.push_back({p,exp});
        }
        return res;
    }
};

