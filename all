#include <bits/stdc++.h>
using namespace std;

// 単調減少でLISしたいときは、数列全体に-1を掛けてLIS、その後もう1回-1を掛ける

// strict=true;  狭義単調増加
// strict=false; 広義単調増加
template<typename T> // 自動で型推論するので指定不要 
// O(NlogN)で
struct LIS{
    int length; // LISの長さ
    vector<T> res; // 復元されたLISの要素
    vector<int> L; // L[i]:i番目の要素を末尾とするLISの長さ

    LIS(const vector<T> &sequence,bool strict=true){
        int n=sequence.size();
        L.assign(n,0);
        if(n==0){
            length=0;
            return;
        }

        vector<T> dp;
        vector<int> dp_id; // dp配列に入っている要素の元のindex
        vector<int> prev(n,-1); // 経路復元用:直前の要素のindex(存在しない場合は-1)

        for(int i=0;i<n;i++){
            const T &x=sequence[i];
            auto it=strict ? lower_bound(dp.begin(),dp.end(),x)  // 狭義単調増加
                           : upper_bound(dp.begin(),dp.end(),x); // 広義単調増加
        
            int idx=it-dp.begin();

            L[i]=idx+1; // 自分が入ったdp配列のindex+1が長さ

            // prevの更新
            if(it!=dp.begin()){
                prev[i]=dp_id[idx-1];
            }

            // dp_idの更新
            if(it==dp.end()){
                dp.push_back(x);
                dp_id.push_back(i);
            }
            else{
                *it=x;
                dp_id[idx]=i;
            }
        }

        length=dp.size();

        // 経路復元
        // LISの最後の要素のindexを取得
        int cur=dp_id.back(); // v.back(); はvの最後の要素を取得する。dp_idにはdpのindexが入ってるからLISの最後の要素のindexが取得できる。

        while(cur!=-1){
            res.push_back(sequence[cur]);
            cur=prev[cur];
        }
        reverse(res.begin(),res.end());
    }
};

