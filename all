#include <bits/stdc++.h>
using namespace std;

// O(|V|^3)ですべての頂点間の最短距離を求める
// V:頂点数

// 負の辺があってもOK
// 負の閉路の判定もできる

const long long INF=1e18;

/*
V×Vの隣接行列のDP配列を用意する。 (0-indexed)
dp[i][j]= i からj の距離
ただし、i==jのとき0、辺がないときINF
返り値:負の閉路が存在するならtrue、そうでなければfalse
*/

bool warshall_floyd(vector<vector<long long>> &dp){
    int V=dp.size();

    // 最短距離の計算
    // 0~kを経由していいときの最短距離を更新していく
    for(int k=0;k<V;k++){         // 経由する頂点
        for(int i=0;i<V;i++){     // 始点
            for(int j=0;j<V;j++){ // 終点

                if(dp[i][k]==INF || dp[k][j]==INF)continue;

                dp[i][j]=min(dp[i][j],dp[i][k]+dp[k][j]);
            }
        }
    }

    // 負の閉路の検出
    // 頂点iからiの最短距離がマイナスのとき、負の閉路が存在する
    for(int i=0;i<V;i++){
        if(dp[i][i]<0)return true;
    }
    
    return false;
}

int main(){
    int V,E;
    // V: 頂点数
    // E: 辺の数

    // 隣接行列の用意
    vector<vector<long long>> dp(V, vector<long long>(V,INF));

    for(int i=0;i<V;i++){
        dp[i][i]=0;
    }

    for(int i=0;i<E;i++){
        int u,v;
        long long cost;
        cin>>u>>v>>cost;

        // 有向か無向かに注意
        dp[u][v]=cost;
    }

    bool negative_cycle = warshall_floyd(dp);

    // 任意の2頂点 x, y の距離
    int x,y;
