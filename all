        res=res*10+(S[pos]-'0');
        pos++; 
    }
    return res;
}

long long factor(int &pos,const string &S){
    if(S[pos]=='('){
        pos++; // '(' を読み飛ばす
        long long res=expression(pos,S);
        pos++; // ')' を読み飛ばす
        return res;
    }
    else{
        return number(pos,S);   
    }
}

long long term(int &pos,const string &S){
    long long res=factor(pos,S); // 左側の値を取得
    while(pos<S.size() && ( S[pos]=='*' || S[pos]=='/' )){
        char op=S[pos];
        pos++;

        long long next_factor=factor(pos,S);
        if(op=='*')res*=next_factor;
        if(op=='/')res/=next_factor;
    }
    return res;
}

long long expression(int &pos,const string &S){
    long long res=term(pos,S);
    while(pos<S.size() && (S[pos]=='+' || S[pos]=='-')){
        char op=S[pos];
        pos++;

        long long next_term=term(pos,S);
        if(op=='+')res+=next_term;
        if(op=='-')res-=next_term;
    }
    return res;
}

